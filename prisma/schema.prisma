generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  name                String
  email               String            @unique
  password            String
  role                UserRole          @default(USER)
  createdAt           DateTime          @default(now())
  avatarUrl           String?
  updatedAt           DateTime          @updatedAt
  activeWorkspaceId   String?
  activityLogs        ActivityLog[]
  comments            Comment[]
  receivedInvitations Invitation[]      @relation("InvitationInvitee")
  sentInvitations     Invitation[]      @relation("InvitationInviter")
  notifications       Notification[]
  ownedOrganizations  Organization[]    @relation("OrganizationOwner")
  createdProjects     Project[]
  projectMembers      ProjectMember[]
  assignedTasks       Task[]            @relation("TaskAssignee")
  createdTasks        Task[]            @relation("TaskCreator")
  ownedWorkspaces     Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers    WorkspaceMember[]
  organizationMembers OrganizationMember[]
}

model Organization {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  logoUrl       String?
  ownerId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isActive      Boolean       @default(true)
  maxMembers    Int           @default(10)
  maxWorkspaces Int           @default(1)
  plan          WorkspacePlan @default(FREE)
  status        OrgStatus     @default(ACTIVE)
  storageLimit  Int           @default(1024)
  invitations   Invitation[]  @relation("OrganizationInvitations")
  owner         User          @relation("OrganizationOwner", fields: [ownerId], references: [id])
  workspaces    Workspace[]
  members       OrganizationMember[]

  @@index([ownerId])
  @@index([status])
}

model OrganizationMember {

  id String @id @default(cuid())

  organizationId String

  userId String

  role OrganizationRole  @default(MEMBER)

  joinedAt DateTime @default(now())

  organization Organization  @relation(fields:[organizationId],references:[id],onDelete: Cascade)

  user User                  @relation(fields:[userId],references:[id],onDelete: Cascade)

  @@unique([organizationId, userId])

  @@index([organizationId])

  @@index([userId])

}

model Workspace {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  iconUrl        String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  isActive       Boolean           @default(true)
  isArchived     Boolean           @default(false)
  ownerId        String
  plan           WorkspacePlan     @default(FREE)
  settings       Json?
  departments    Department[]
  invitations    Invitation[]      @relation("WorkspaceInvitations")
  projects       Project[]
  teams          Team[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members        WorkspaceMember[]

  @@unique([organizationId, slug])
}

model Department {
  id          String    @id @default(cuid())
  name        String
  workspaceId String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teams       Team[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Team {
  id           String       @id @default(cuid())
  name         String
  description  String?
  workspaceId  String
  departmentId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  department   Department?  @relation(fields: [departmentId], references: [id])
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([departmentId])
}

model WorkspaceMember {
  id             String          @id @default(cuid())
  workspaceId    String
  userId         String
  role           WorkspaceRole   @default(DEVELOPER)
  joinedAt       DateTime        @default(now())
  projectMembers ProjectMember[]
  teams          TeamMember[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model TeamMember {
  id                String          @id @default(cuid())
  teamId            String
  workspaceMemberId String
  joinedAt          DateTime        @default(now())
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspaceMember   WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, workspaceMemberId])
  @@index([workspaceMemberId])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  message        String?
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  role           WorkspaceRole    @default(DEVELOPER)
  inviterId      String
  inviteeId      String?
  organizationId String?
  workspaceId    String?
  expiresAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  invitee        User?            @relation("InvitationInvitee", fields: [inviteeId], references: [id])
  inviter        User             @relation("InvitationInviter", fields: [inviterId], references: [id])
  organization   Organization?    @relation("OrganizationInvitations", fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?       @relation("WorkspaceInvitations", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([inviterId])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String
  startDate   DateTime?
  endDate     DateTime?
  progress    Int             @default(0)
  health      ProjectHealth   @default(ON_TRACK)
  riskLevel   RiskLevel       @default(MEDIUM)
  priority    Priority        @default(MEDIUM)
  workspaceId String
  key         String
  status      ProjectStatus   @default(PLANNED)
  epics       Epic[]
  createdBy   User            @relation(fields: [createdById], references: [id])
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  sprints     Sprint[]
  tasks       Task[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model ProjectMember {
  id                String          @id @default(cuid())
  projectId         String
  userId            String?
  createdAt         DateTime        @default(now())
  workspaceMemberId String
  role              ProjectRole     @default(MEMBER)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User?           @relation(fields: [userId], references: [id])
  workspaceMember   WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([projectId, workspaceMemberId])

  @@index([projectId])

  @@index([workspaceMemberId])
}

model Task {
  id           String          @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus      @default(TODO)
  priority     Priority        @default(MEDIUM)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String
  assignedToId String?
  projectId    String
  epicId       String?
  number       Int
  sprintId     String?
  workspaceId  String
  activities   ActivityLog[]
  attachments  Attachment[]
  checklist    ChecklistItem[]
  comments     Comment[]
  assignedTo   User?           @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User            @relation("TaskCreator", fields: [createdById], references: [id])
  epic         Epic?           @relation(fields: [epicId], references: [id])
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?         @relation(fields: [sprintId], references: [id])


  @@unique([projectId, number])

  @@index([projectId, status])
  @@index([assignedToId])
}

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String?
  projectId String
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Epic {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  taskId      String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  workspaceId String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String
  details     Json?
  userId      String
  createdAt   DateTime @default(now())
  taskId      String?
  workspaceId String
  task        Task?    @relation(fields: [taskId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  filename  String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
enum UserRole {
  SUPER_ADMIN
  USER
}
enum OrganizationRole {
    OWNER
    ADMIN
    MEMBER
}

enum WorkspaceRole {
    ADMIN
    PROJECT_MANAGER
    TEAM_LEAD
    DEVELOPER
    QA
    CLIENT
    GUEST
}

enum WorkspacePlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ON_HOLD
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BACKLOG
  REVIEW
  TESTING
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}
